# Shell scripts, Python, and Dockerfiles must stay LF — a CRLF checkout on
# Windows breaks the container entrypoint (learned the hard way in MNA-noMBA).
*.sh text eol=lf
*.py text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.md text eol=lf
